{
  "name": "kontextmind",
  "version": "0.1.0",
  "description": "kontextmind serve — run a KontextMind server with zero install: mind repo, database, and config persisted under one data directory",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "kontextmind": "dist/serve.mjs" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18.17" },
  "repository": { "type": "git", "url": "git+https://github.com/kontextmind/mind.git" },
  "homepage": "https://github.com/kontextmind/mind",
  "keywords": ["kontextmind", "ai-agents", "mcp", "memory", "server"],
  "scripts": {
    "generate": "bun run generate-migrations.mjs",
    "build": "bun run generate && bun run build.mjs",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
